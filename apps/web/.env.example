# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon Postgres. The app and the laptop-side Worker share this. (OR-9)
# Pooled (pgbouncer) endpoint — used by the app through Neon's HTTP driver.
DATABASE_URL=
# Direct endpoint, no pgbouncer. Used by drizzle-kit for migrations, which run over
# a plain TCP session that pgbouncer's transaction mode cannot fully support.
DATABASE_URL_UNPOOLED=

# Better Auth. (OR-11)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production is https://openrecipe-michynows-projects.vercel.app
# openrecipe.vercel.app belongs to an unrelated app — do not use it.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The single Master account, matched by email at login. Never grantable in the UI. (OR-12)
MASTER_EMAIL=

# Vercel Blob, for Recipe images. (OR-22)
BLOB_READ_WRITE_TOKEN=

# Cloud import kitchen (ADR-0006). The app wakes the GitHub Actions worker the
# moment a link is parked. Fine-grained token, this repository only,
# permission "Contents: Read and write" (repository_dispatch needs it). Leave empty to rely on the 30-minute
# cron or the laptop worker.
GITHUB_DISPATCH_TOKEN=
# owner/repo. Optional on Vercel, which provides VERCEL_GIT_REPO_OWNER/_SLUG.
GITHUB_REPOSITORY=michynow/openrecipe

# "Draft finished" Android push (FCM HTTP v1). The whole Firebase service-account
# JSON on one line. Optional: unset = no notifications.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
