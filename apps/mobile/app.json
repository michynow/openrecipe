{
  "expo": {
    "name": "OpenRecipe",
    "slug": "openrecipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "openrecipe",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.openrecipe.android",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "drafts"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
