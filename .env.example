# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon Postgres. The app and the laptop-side Worker share this. (OR-9)
DATABASE_URL=

# Better Auth. (OR-11)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production is https://openrecipe-michynows-projects.vercel.app
# openrecipe.vercel.app belongs to an unrelated app — do not use it.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The single Master account, matched by email at login. Never grantable in the UI. (OR-12)
MASTER_EMAIL=

# Vercel Blob, for Recipe images. (OR-22)
BLOB_READ_WRITE_TOKEN=
