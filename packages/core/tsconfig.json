{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `node --test` strips types and does no extension resolution, so relative
    // imports carry `.ts`. Legal because nothing is emitted.
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
